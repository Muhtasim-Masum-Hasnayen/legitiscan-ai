# Copy to backend/.env and edit.
ENVIRONMENT=development
# Zero-config local dev (SQLite file). For PostgreSQL use e.g.:
#   DATABASE_URL=postgresql://legitiscan:legitiscan@localhost:5432/legitiscan
DATABASE_URL=sqlite:///./legitiscan_dev.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REQUIRE_AUTH=false
# Comma-separated list of frontend origins allowed by CORS (add your Vercel URL)
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
SCAN_RATE_LIMIT_PER_MINUTE=10

MAX_UPLOAD_MB=10
MAX_FILES_PER_SCAN=3

# AI assets (see docs/MODEL_INTEGRATION.md)
ML_ENABLED=true
RESNET_WEIGHTS_FILE=resnet50_cosmetics.pt
LABELS_FILE=labels.json
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
OCR_LANGUAGES=en
OCR_GPU=false

# Decision thresholds - tune on your own validation set
AUTHENTIC_THRESHOLD=0.75
COUNTERFEIT_THRESHOLD=0.30
DISAGREEMENT_THRESHOLD=0.50
BLUR_MIN_VARIANCE=25
